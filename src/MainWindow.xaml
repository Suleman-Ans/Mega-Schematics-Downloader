<Window x:Class="MegaSchematicsDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mega Schematics Downloader" Height="740" Width="1040"
        MinHeight="560" MinWidth="820" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextBrush}"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="MEGA SCHEMATICS" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Community motherboard schematics and boardviews"
                           Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Upload contribution" Click="Upload_Click" />
                <Button Content="GitHub" Click="Github_Click" />
            </StackPanel>
        </Grid>

        <!-- Navigation and search -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Grid.Column="0" Content="Back" Click="Back_Click" IsEnabled="False"
                    ToolTip="Go up one folder (Backspace)" />
            <Button x:Name="HomeButton" Grid.Column="1" Content="Home" Click="Home_Click" IsEnabled="False" />
            <Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh" Click="Refresh_Click"
                    ToolTip="Reload the file index from MEGA (F5)" />
            <TextBox x:Name="SearchBox" Grid.Column="3" Margin="10,3" VerticalContentAlignment="Center"
                     ToolTip="Search folders and file names. Every word must match. (Ctrl+F)"
                     TextChanged="SearchBox_TextChanged" />
            <Button x:Name="ClearSearchButton" Grid.Column="4" Content="Clear" Click="ClearSearch_Click" />
            <CheckBox x:Name="CurrentFolderOnlyCheck" Grid.Column="5" Content="Current folder only"
                      Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="8,0"
                      Checked="ScopeCheck_Changed" Unchecked="ScopeCheck_Changed" />
            <Button x:Name="SortButton" Grid.Column="6" Content="Sort: Name A-Z" MinWidth="120" Click="Sort_Click" />
        </Grid>

        <!-- File list -->
        <Border Grid.Row="2" Background="{StaticResource PanelBackground}" CornerRadius="8" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="8,5,8,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LocationText" Text="Not connected" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CountText" Grid.Column="1" Foreground="{StaticResource MutedBrush}" />
                </Grid>
                <ListView x:Name="ItemsList" Grid.Row="1"
                          Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionChanged="ItemsList_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="#293544" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#324357" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2F4F78" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="MouseDoubleClick" Handler="Item_DoubleClick" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="42">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding KindLabel}" Foreground="{StaticResource MutedBrush}"
                                           FontSize="10" VerticalAlignment="Center" Margin="8,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,2">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}" />
                                    <TextBlock Text="{Binding LocationText}" Visibility="{Binding LocationVisibility}"
                                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding LocationText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" TextAlignment="Right"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                           Margin="8,0" />
                                <TextBlock Grid.Column="3" Text="{Binding StatusText}" TextAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}" FontSize="11"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="4" Content="{Binding ActionLabel}" Click="ItemAction_Click"
                                        MinWidth="86" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Download actions -->
        <WrapPanel Grid.Row="3" Margin="0,12,0,0">
            <Button x:Name="DownloadSelectedButton" Content="Download selected" Click="DownloadSelected_Click"
                    ToolTip="Download the selected files and folders. Ctrl+click or Shift+click to select several."
                    IsEnabled="False" />
            <Button x:Name="DownloadViewButton" Content="Download this folder" Click="DownloadView_Click"
                    IsEnabled="False" />
            <Button x:Name="DownloadAllButton" Content="Download full database" Click="DownloadAll_Click"
                    Style="{StaticResource AccentButton}" IsEnabled="False"
                    ToolTip="Download every file, keeping the folder structure. Files already on disk are skipped." />
            <Button x:Name="OpenDownloadsButton" Content="Open download folder" Click="OpenDownloads_Click" />
            <Button x:Name="ChangeFolderButton" Content="Change folder" Click="ChangeFolder_Click" />
        </WrapPanel>

        <!-- Progress (only while a download runs) -->
        <Grid x:Name="ProgressPanel" Grid.Row="4" Margin="3,10,3,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" />
                <TextBlock x:Name="ProgressText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Background="#B04A4A"
                    Click="Cancel_Click" ToolTip="Stops after the file currently downloading finishes." />
        </Grid>

        <!-- Status -->
        <Grid Grid.Row="5" Margin="3,12,3,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="SyncText" Grid.Column="1" Foreground="{StaticResource AccentBrush}"
                       VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="FolderText" Grid.Column="2" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" Margin="12,0,0,0" />
        </Grid>
    </Grid>
</Window>
